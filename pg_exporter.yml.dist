listen_addr: 0.0.0.0:61488
# scrape_timeout_ms: 30000   # max time (ms) to wait for all collectors per scrape; default 30000

instances:
  "pg15:5432":
    dsn: "postgres://postgres_exporter:postgres_exporter@pge15:5432/db1"
    exclude_db_names: ["postgres", "template", "template1", "template0"]
    const_labels:
      project: "test_project15"
      cluster: "test_cluster15"
    collect_top_query: 10
    collect_top_index: 10
    no_track_mode: true
    # pool_max_connections: 10        # max open connections in the pool
    # pool_acquire_timeout_secs: 5    # seconds to wait for a free connection
    # pool_idle_timeout_secs: 300     # seconds before an idle connection is closed
    # pool_max_lifetime_secs: 1800    # max lifetime of a connection

  "pg17:6432":
    dsn: "postgres://postgres_exporter:postgres_exporter@pge17:5432/db17"
    exclude_db_names: ["postgres", "template", "template1", "template0"]
    const_labels:
      project: "test_project17"
      cluster: "test_cluster17"
    collect_top_query: 10
    collect_top_index: 10
    no_track_mode: true
    # pool_max_connections: 10
    # pool_acquire_timeout_secs: 5
    # pool_idle_timeout_secs: 300
    # pool_max_lifetime_secs: 1800
